<div class="panel"><div class="panel-heading"><i class="icon-list"></i> {l s='Productos' mod='fabricssamples'}</div>
<form method="get" class="form-inline"><input type="hidden" name="controller" value="AdminFabricSamples"><input type="hidden" name="token" value="{$smarty.get.token|escape:'htmlall':'UTF-8'}"><input class="form-control" name="product_filter" value="{$fs_admin_filter|escape:'htmlall':'UTF-8'}" placeholder="{l s='ID, nombre o referencia' mod='fabricssamples'}"><select class="form-control" name="limit">{foreach from=[20,50,100,250,500] item=n}<option value="{$n}"{if $fs_admin_limit==$n} selected{/if}>{$n}</option>{/foreach}</select><button class="btn btn-default" type="submit">{l s='Filtrar' mod='fabricssamples'}</button></form>
<form method="post" action="{$fs_admin_link|escape:'htmlall':'UTF-8'}"><div class="table-responsive"><table class="table"><thead><tr><th></th><th>ID</th><th>{l s='Nombre' mod='fabricssamples'}</th><th>{l s='Referencia' mod='fabricssamples'}</th><th>{l s='Producto' mod='fabricssamples'}</th><th>{l s='Muestra' mod='fabricssamples'}</th><th>{l s='Precio' mod='fabricssamples'}</th><th>{l s='Stock muestras' mod='fabricssamples'}</th><th></th></tr></thead><tbody>
{foreach from=$fs_admin_products item=p}<tr><td><input type="checkbox" name="productBox[]" value="{$p.id_product|intval}"></td><td>{$p.id_product|intval}</td><td>{$p.name|escape:'htmlall':'UTF-8'}</td><td>{$p.reference|escape:'htmlall':'UTF-8'}</td><td>{if $p.product_active}<span class="label label-success">{l s='Activo' mod='fabricssamples'}</span>{else}<span class="label label-default">{l s='Inactivo' mod='fabricssamples'}</span>{/if}</td><td>{if $p.sample_active}<span class="label label-success">{l s='Sí' mod='fabricssamples'}</span>{else}<span class="label label-default">{l s='No' mod='fabricssamples'}</span>{/if}</td><td>{if $p.use_default_price}{$fs_default_price|escape:'htmlall':'UTF-8'}{else}{$p.sample_price|escape:'htmlall':'UTF-8'}{/if}</td><td>{$p.sample_stock|intval}</td><td><a class="btn btn-default" href="{$fs_admin_link|escape:'htmlall':'UTF-8'}&edit_product={$p.id_product|intval}"><i class="icon-pencil"></i> {l s='Editar' mod='fabricssamples'}</a></td></tr>{/foreach}
</tbody></table></div><button class="btn btn-success" name="bulkEnableSamples">{l s='Activar seleccionadas' mod='fabricssamples'}</button> <button class="btn btn-warning" name="bulkDisableSamples">{l s='Desactivar seleccionadas' mod='fabricssamples'}</button></form>
{if $fs_admin_pages>1}<ul class="pagination">{foreach from=$fs_admin_pagination_window item=page_number}{if $page_number>0}<li class="{if $fs_admin_page==$page_number}active{/if}"><a href="{$fs_admin_link|escape:'htmlall':'UTF-8'}&page={$page_number|intval}&limit={$fs_admin_limit|intval}&product_filter={$fs_admin_filter|urlencode}">{$page_number|intval}</a></li>{else}<li class="disabled"><span>…</span></li>{/if}{/foreach}</ul>{/if}
</div>
