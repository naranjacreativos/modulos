{
  "name": "naranjacreativos/fabricssamples",
  "description": "Advanced fabric samples module for PrestaShop 8 and 9",
  "type": "prestashop-module",
  "license": "proprietary",
  "authors": [
    {
      "name": "Naranja Creativos"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12 || ^2.1",
    "phpunit/phpunit": "^10.5",
    "prestashop/php-dev-tools": "^4.3 || ^5.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "NaranjaCreativos\\FabricSamples\\": "src/"
    },
    "classmap": [
      "fabricssamples.php",
      "controllers/"
    ]
  },
  "config": {
    "prepend-autoloader": false,
    "sort-packages": true
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:phpunit": "phpunit --configuration phpunit.xml.dist",
    "quality:phpstan": "phpstan analyse --configuration phpstan.neon.dist",
    "quality:phpcs": "phpcs --standard=phpcs.xml.dist",
    "validate": "sh bin/validate-module.sh",
    "test:integration": "sh tests/integration/run.sh"
  }
}
